{
  "functions": {
    "api/app.py": {
      "runtime": "python3.12",
      "includeFiles": "api/*.py",
      "regions": ["icn1"]
    }
  },
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/app.py"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}